# Never ship real KYC data or secrets into an image.
# EXCEPTION: data/sample_synthetic/ holds the PII-free regulatory KB (synthetic AML
# rules + KYC guidelines) the startup seed embeds — this subset IS baked in.
data/*
!data/sample_synthetic/
.env
Neo4j-*.txt
*credentials*.txt
*.pem
*.key

# Dev / infra artifacts
tests/
terraform/
.github/
.trivyignore
.checkov.yaml
.secrets.baseline
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
__pycache__/
*.py[cod]
.venv/
venv/
*.md
!README.md
.git/
.gitignore
.DS_Store
/tmp/chroma/
chroma/
