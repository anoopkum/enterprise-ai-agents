# ─────────────────────────────────────────────────────────────────────────────
# Day 03 — KYC/AML Compliance Automation
# Every Azure setting is OPTIONAL. With none set, the pipeline runs fully local:
#   ChromaDB (vector) + NetworkX (graph) + PyMuPDF/Unstructured (OCR).
# Set the Azure vars to upgrade to AI Search + Neo4j + Document Intelligence.
# ─────────────────────────────────────────────────────────────────────────────

# Data location — real multi-format files live OUTSIDE the repo (gitignored).
DATA_DIR=/Users/anoo4413/Documents/enterprise-ai-agents/data

# Azure Authentication
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_RESOURCE_GROUP=rg-kyc-agent-dev

# Azure AI Foundry — GPT-4o reasoning model
AI_FOUNDRY_ENDPOINT=https://oai-aihub-kyc-agent.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# Azure AI Search (vector DB). Unset → ChromaDB local fallback.
AZURE_SEARCH_ENDPOINT=https://srch-kyc-agent.search.windows.net
AZURE_SEARCH_INDEX=kyc-regulatory-kb
# Auth via Managed Identity in prod; key only for local dev
AZURE_SEARCH_KEY=

# Azure AI Document Intelligence (OCR for scanned IDs/PDF/JPEG). Unset → PyMuPDF local OCR.
DOC_INTELLIGENCE_ENDPOINT=https://di-kyc-agent.cognitiveservices.azure.com
DOC_INTELLIGENCE_KEY=

# Neo4j knowledge graph. Unset → in-memory NetworkX fallback.
# Neo4j Aura (managed): neo4j+s://<instance-id>.databases.neo4j.io  (user is always "neo4j")
# Local Docker:         bolt://localhost:7687
# The password is shown ONCE at instance creation (downloadable credentials file).
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ChromaDB (local vector fallback)
CHROMA_PERSIST_DIR=/tmp/chroma/kyc

# Retrieval tuning
TOP_K_RETRIEVE=10
TOP_K_RERANK=5
RERANKER=azure          # azure | cross_encoder | none
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Guardrails
HALLUCINATION_NLI_THRESHOLD=0.5
ENABLE_PII_REDACTION=true

# Application
ENVIRONMENT=dev

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Decision thresholds
EDD_RISK_THRESHOLD=0.60
REJECT_RISK_THRESHOLD=0.85
