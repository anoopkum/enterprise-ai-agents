# Azure Authentication
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_RESOURCE_GROUP=rg-loan-agent-dev

# Azure AI Foundry — AgentsClient endpoint (Azure OpenAI endpoint, not Hub connection string)
AI_FOUNDRY_ENDPOINT=https://ai-automation-rxt-resource.services.ai.azure.com/api/projects/ai-automation-rxt
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ML Model
MODEL_PATH=models/credit_risk_model.pkl
FEATURE_NAMES_PATH=models/feature_names.json
MODEL_VERSION=1.0.0

# MLflow
MLFLOW_TRACKING_URI=mlruns
# For Azure ML: MLFLOW_TRACKING_URI=azureml://eastus.api.azureml.ms/mlflow/v1.0/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<workspace>

# ChromaDB
CHROMA_PERSIST_DIR=/tmp/chroma/applications
REGULATORY_KB_PATH=data/regulatory_kb.json

# Application
ENVIRONMENT=dev

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Risk thresholds (override defaults)
DTI_HIGH_THRESHOLD=0.45
DTI_CRITICAL_THRESHOLD=0.55
LTI_HIGH_THRESHOLD=4.5
MIN_CREDIT_SCORE_APPROVE=550
