# Azure Authentication
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_RESOURCE_GROUP=rg-fraud-agent-dev

# Azure AI Foundry
AI_FOUNDRY_CONNECTION_STRING=<region>.api.azureml.ms;<subscription-id>;<resource-group>;<project-name>
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Cosmos DB
COSMOS_DB_ENDPOINT=https://cosmos-fraud-agent-dev.documents.azure.com:443/
COSMOS_DB_NAME=frauddb

# Azure Event Hub
EVENT_HUB_NAMESPACE=evhns-fraud-agent-dev
EVENT_HUB_NAME=transactions

# Azure Service Bus
SERVICE_BUS_NAMESPACE=sb-fraud-agent-dev

# Application
ENVIRONMENT=dev
FRAUD_API_URL=http://localhost:8000/analyze
FRAUD_API_KEY=change-me-in-production

# Velocity Thresholds
VELOCITY_MAX_TXN_PER_HOUR=5
VELOCITY_MAX_TXN_PER_DAY=20
VELOCITY_AMOUNT_SPIKE_MULTIPLIER=5.0
IMPOSSIBLE_TRAVEL_SPEED_KMH=900

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
